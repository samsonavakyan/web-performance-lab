{
  "name": "web-performance-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @marketlab/api",
    "dev:web": "npm run dev -w @marketlab/web",
    "build": "npm run build -w @marketlab/web",
    "typecheck": "npm run typecheck -w @marketlab/web",
    "test": "node --test apps/api/data.test.mjs",
    "preview": "node scripts/dev.mjs --preview",
    "preview:api": "npm run start -w @marketlab/api",
    "preview:web": "npm run preview -w @marketlab/web",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
